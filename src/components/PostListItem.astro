---
import TagPill from './TagPill.astro';
import { formatDate } from '../lib/formatDate';
import { partLabel, seriesColors, type PostSeries } from '../lib/series';

interface Props {
  href: string;
  title: string;
  date?: Date;
  dateStyle?: 'long' | 'short';
  description?: string;
  tags?: string[];
  /** A series post's place in it, shown above the title, e.g. "Homelab · Part 4",
      as a link to the blog filtered to that series */
  series?: PostSeries;
  /** Make the whole list item the click target */
  stretched?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  title,
  date,
  dateStyle = 'short',
  description,
  tags = [],
  series,
  stretched = false,
  class: className,
  ...rest
} = Astro.props;

// Drop Astro's internal scope-cascade props so they don't render as attributes
const attrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => !key.startsWith('data-astro-cid'))
);
---

<li
  class:list={['post-list-item', stretched && 'post-list-item--stretched', className]}
  {...attrs}
>
  {series && (
    <a href={`/blog/?series=${series.id}`} class="post-series-label caps-label" style={seriesColors(series.id)}>{partLabel(series)}</a>
  )}
  <a href={href} class:list={['post-link', stretched && 'post-link--stretched']}>
    <span class="post-title">{title}</span>
    {date && (
      <time datetime={date.toISOString()} class="post-date">{formatDate(date, dateStyle)}</time>
    )}
  </a>
  {description && <p class="post-excerpt">{description}</p>}
  {tags.length > 0 && (
    <div class="post-list-tags">
      {tags.map((tag) => (
        <TagPill tag={tag} />
      ))}
    </div>
  )}
</li>
