---
import SeriesCrumbs from './SeriesCrumbs.astro';
import TagPill from './TagPill.astro';
import { formatDate } from '../lib/formatDate';
import type { PostSeries } from '../lib/series';

interface Props {
  href: string;
  title: string;
  date?: Date;
  dateStyle?: 'long' | 'short';
  description?: string;
  /** e.g. "5 min read"; shown with the date */
  readTime?: string;
  tags?: string[];
  /** A series post's place in it, shown above the title, e.g. "Homelab ›
      Foundations › Part 4", the series and topic linking to the blog filtered to them */
  series?: PostSeries;
  /** Make the whole list item the click target */
  stretched?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  title,
  date,
  dateStyle = 'short',
  description,
  readTime,
  tags = [],
  series,
  stretched = false,
  class: className,
  ...rest
} = Astro.props;

// Drop Astro's internal scope-cascade props so they don't render as attributes
const attrs = Object.fromEntries(
  Object.entries(rest).filter(([key]) => !key.startsWith('data-astro-cid'))
);
---

<li
  class:list={['post-list-item', stretched && 'post-list-item--stretched', className]}
  {...attrs}
>
  {series && (
    <SeriesCrumbs series={series} />
  )}
  <a href={href} class:list={['post-link', stretched && 'post-link--stretched']}>
    <span class="post-title">{title}</span>
    {date && (
      <span class="post-when">
        <time datetime={date.toISOString()} class="post-date">{formatDate(date, dateStyle)}</time>
        {readTime && <span class="post-when-separator" aria-hidden="true">&middot;</span>}
        {readTime && <span class="post-read-time">{readTime}</span>}
      </span>
    )}
  </a>
  {description && <p class="post-excerpt">{description}</p>}
  {tags.length > 0 && (
    <div class="post-list-tags">
      {tags.map((tag) => (
        <TagPill tag={tag} />
      ))}
    </div>
  )}
</li>
