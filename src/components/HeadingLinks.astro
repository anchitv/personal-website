---
// Styles and click-to-copy for the heading links added by src/rehype-heading-links.mjs
---

<p class="heading-link-status" role="status"></p>

<style is:global>
  .heading-link {
    margin-left: 0.3em;
    color: var(--color-text-muted);
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity var(--duration-150) ease;
  }

  .heading-link::before {
    content: '#';
  }

  .heading-link[data-copied]::before {
    content: 'Copied';
    font-size: var(--text-ui);
  }

  :is(h2, h3, h4, h5, h6):hover > .heading-link,
  .heading-link:focus-visible,
  .heading-link[data-copied] {
    opacity: 1;
  }

  /* Touch screens can't hover, so keep the link faintly visible */
  @media (hover: none) {
    .heading-link {
      opacity: 0.5;
    }
  }

  /* Announces the copy to screen readers without showing on screen */
  .heading-link-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  let resetTimer: ReturnType<typeof setTimeout> | undefined;

  // Capture phase, so this runs before ClientRouter's click handler on document
  document.addEventListener('click', async (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('.heading-link');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();

    // Put the link in the address bar, keeping ClientRouter's history state
    history.replaceState(history.state, '', link.hash);
    link.parentElement?.scrollIntoView();
    try {
      await navigator.clipboard.writeText(location.origin + location.pathname + link.hash);
    } catch {
      return; // No clipboard access; the link is still in the address bar
    }

    clearTimeout(resetTimer);
    document.querySelector('.heading-link[data-copied]')?.removeAttribute('data-copied');
    link.dataset.copied = '';
    const status = document.querySelector('.heading-link-status');
    if (status) status.textContent = 'Link copied';
    resetTimer = setTimeout(() => {
      link.removeAttribute('data-copied');
      if (status) status.textContent = '';
    }, 2000);
  }, true);
</script>
