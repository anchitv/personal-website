---
import type { CollectionEntry } from 'astro:content';
import { seriesColors, seriesName, seriesOutline, topicDescription, type SeriesItem, type SeriesPart } from '../lib/series';

interface Props {
  /** Series slug */
  id: string;
  /** Published posts */
  posts: CollectionEntry<'blog'>[];
  /** id of the post being shown */
  current: string;
}

const { id, posts, current } = Astro.props;

const outline = seriesOutline(id);
const published = new Map(posts.map((post) => [post.id, post]));
// Readers only see published parts: drafts keep their number but stay hidden
const readable = outline.parts.filter((part) => published.has(part.post));
const shownItems = outline.items.flatMap((item): SeriesItem[] => {
  if (!('parts' in item)) return published.has(item.post) ? [item] : [];
  const parts = item.parts.filter((part) => published.has(part.post));
  return parts.length > 0 ? [{ ...item, parts }] : [];
});
// Runs of parts under the same topic, each shown under its heading
const groups: { topic?: string; items: SeriesItem[] }[] = [];
for (const item of shownItems) {
  const last = groups.at(-1);
  if (last && last.topic === item.topic) last.items.push(item);
  else groups.push({ topic: item.topic, items: [item] });
}
const index = readable.findIndex((part) => part.post === current);
// The cards stay inside the topic: its first part has no previous card and its last no next card
const here = readable[index];
const before = readable[index - 1];
const after = readable[index + 1];
const prev = before?.topic === here?.topic ? before : undefined;
const next = after?.topic === here?.topic ? after : undefined;
// The last part of a topic points to the next topic instead, starting at its first published part
const nextTopic = here && after?.topic && after.topic !== here.topic ? after : undefined;
const nextTopicParts = nextTopic ? readable.filter((part) => part.topic === nextTopic.topic).length : 0;
const partOf = (part: SeriesPart) => `Part ${part.number}`;

const titleOf = (part: SeriesPart) => published.get(part.post)!.data.title;
const hrefOf = (part: SeriesPart) => `/blog/${part.post}/`;
---

<nav class="series-nav" aria-label={`${seriesName(id)} series`} style={seriesColors(id)}>
  {(prev || next) && (
    <div class="series-cards">
      {prev && (
        <a href={hrefOf(prev)} rel="prev" class="series-card series-card--prev">
          <span class="caps-label">&larr; Previous &middot; {partOf(prev)}</span>
          <span class="series-card-title">{titleOf(prev)}</span>
          <span class="series-card-description">{published.get(prev.post)!.data.description}</span>
        </a>
      )}
      {next && (
        <a href={hrefOf(next)} rel="next" class="series-card series-card--next">
          <span class="caps-label">Next &middot; {partOf(next)} &rarr;</span>
          <span class="series-card-title">{titleOf(next)}</span>
          <span class="series-card-description">{published.get(next.post)!.data.description}</span>
        </a>
      )}
    </div>
  )}

  {nextTopic && (
    <a href={hrefOf(nextTopic)} rel="next" class="next-topic">
      <span class="caps-label">Up next in {seriesName(id)}</span>
      <span class="next-topic-title">{nextTopic.topic}</span>
      <span class="next-topic-description">{topicDescription(id, nextTopic.topic!)}</span>
      <span class="next-topic-start">
        {nextTopicParts} {nextTopicParts === 1 ? 'part' : 'parts'} &middot; Start with {partOf(nextTopic)}: {titleOf(nextTopic)} &rarr;
      </span>
    </a>
  )}

  <!-- Every published part, so readers can jump anywhere in the series -->
  <details class="series-all">
    <summary class="caps-label">All {shownItems.length} parts</summary>
    {groups.map((group) => (
      <>
        {group.topic && <p class="series-all-topic">{group.topic}</p>}
        <ol class="series-all-list">
          {group.items.map((item) =>
            'parts' in item ? (
              <li>
                <span class="series-all-number">{item.number}</span>
                <span class="series-all-group">{item.title}</span>
                <ol class="series-all-list series-all-list--sub">
                  {item.parts.map((part) => (
                    <li>
                      <span class="series-all-number">{part.number}</span>
                      {part.post === current ? (
                        <span class="series-all-current" aria-current="page">{titleOf(part)}</span>
                      ) : (
                        <a href={hrefOf(part)}>{titleOf(part)}</a>
                      )}
                    </li>
                  ))}
                </ol>
              </li>
            ) : (
              <li>
                <span class="series-all-number">{item.number}</span>
                {item.post === current ? (
                  <span class="series-all-current" aria-current="page">{titleOf(item)}</span>
                ) : (
                  <a href={hrefOf(item)}>{titleOf(item)}</a>
                )}
              </li>
            ),
          )}
        </ol>
      </>
    ))}
  </details>
</nav>

<style>
  .series-nav {
    margin-top: var(--space-xl);
  }

  .series-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .series-card,
  .next-topic {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid color-mix(in srgb, var(--color-series-surface) var(--series-edge), var(--color-border));
    border-radius: var(--radius-xl);
    background-color: color-mix(in srgb, var(--color-series-surface) var(--series-tint), var(--color-bg));
    text-decoration: none;
    transition: border-color var(--duration-200) ease, background-color var(--duration-200) ease, transform var(--duration-200) ease;
  }

  .series-card:hover,
  .next-topic:hover {
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-series-surface) var(--series-tint-hover), var(--color-bg));
    transform: translateY(-2px);
  }

  /* Next is where most readers go, so it keeps the tint; Previous is just
     an outline until hovered */
  .series-card--prev:not(:hover) {
    background-color: transparent;
  }

  /* Next stays on the right even when there is no previous part */
  .series-card--next {
    grid-column: 2;
    text-align: right;
  }

  .series-card-title {
    font-family: var(--font-heading);
    font-size: var(--text-title);
    font-weight: 600;
    color: var(--color-text-heading);
    line-height: var(--leading-heading);
    text-wrap: balance;
  }

  .series-card-description,
  .next-topic-description {
    font-size: var(--text-description);
    color: var(--color-text-muted);
  }

  /* === NEXT TOPIC: the whole width, under the previous card === */
  .next-topic {
    padding: var(--space-sm) var(--space-lg);
  }

  .series-cards + .next-topic {
    margin-top: var(--space-sm);
  }

  .next-topic-title {
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--color-text-heading);
    line-height: var(--leading-heading);
    text-wrap: balance;
  }

  .next-topic-start {
    margin-top: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-ui);
    font-weight: 600;
  }

  /* === ALL PARTS === */
  .series-all {
    margin-top: var(--space-md);
  }

  .series-all summary {
    cursor: pointer;
    color: var(--color-accent);
    width: fit-content;
  }

  .series-all-list {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
    font-family: var(--font-heading);
    font-size: var(--text-ui);
  }

  .series-all-list li {
    margin: 0;
    padding: 0.15em 0;
  }

  .series-all-topic {
    margin: var(--space-md) 0 0;
    font-family: var(--font-heading);
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .series-all-topic + .series-all-list {
    margin-top: 0.15em;
  }

  /* Numbers in a fixed column, so the titles line up */
  .series-all-number {
    display: inline-block;
    min-width: 2.5em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .series-all-list--sub {
    margin: 0.15em 0 0 2.5em;
  }

  .series-all-group {
    color: var(--color-text-heading);
  }

  .series-all-list a {
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .series-all-list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .series-all-current {
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Phones: too narrow for two cards, so they stack */
  @media (max-width: 480px) {
    .series-cards {
      grid-template-columns: 1fr;
    }

    .series-card--next {
      grid-column: 1;
    }
  }
</style>
