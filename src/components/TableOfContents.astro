---
import type { MarkdownHeading } from 'astro';

interface Props {
  /** The post's h2 and h3 headings, in order */
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<nav class="toc" aria-label="Table of contents">
  <span class="toc-label caps-label">Contents</span>
  <ol class="toc-list">
    {headings.map((heading) => (
      <li class:list={[heading.depth === 3 && 'toc-sub']}>
        <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .toc {
    font-family: var(--font-heading);
  }

  /* A labelled block, like the lists beside a note: the label at the size
     of the groups under a note, in the text colour, with a rule beneath.
     The label and links have the same padding as a note's, so the text
     lines up the same way */
  .toc-label {
    display: block;
    margin-bottom: var(--space-xs);
    padding: 0 var(--space-sm) var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-list-heading);
    line-height: var(--leading-heading);
    color: var(--color-text);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-ui);
  }

  .toc-sub {
    padding-left: 0.9em;
    font-size: 0.92em;
  }

  /* A word too long for the line wraps rather than overflowing */
  .toc-link {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-md);
    overflow-wrap: anywhere;
    color: var(--color-text);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition: color var(--duration-150) ease, background-color var(--duration-150) ease;
  }

  .toc-link:hover {
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
</style>
