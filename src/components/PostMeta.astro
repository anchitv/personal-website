---
import TagPill from './TagPill.astro';

interface Props {
  date: Date;
  readTime?: string;
  tags?: string[];
}

const { date, readTime, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="post-meta">
  <time datetime={date.toISOString()}>{formattedDate}</time>
  {readTime && <span class="meta-separator">&middot;</span>}
  {readTime && <span>{readTime}</span>}
  {tags.length > 0 && (
    <div class="post-tags">
      {tags.map((tag) => (
        <TagPill tag={tag} />
      ))}
    </div>
  )}
</div>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4em;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    margin-top: var(--space-xs);
  }

  .meta-separator {
    opacity: 0.4;
  }

  .post-tags {
    display: flex;
    gap: 0.35em;
    flex-wrap: wrap;
    margin-left: 0.3em;
  }

</style>
