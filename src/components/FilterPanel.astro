---
import { tagLabel, sortTags } from '../lib/tags';
import { seriesColors, seriesName, topicId } from '../lib/series';

interface Props {
  /** Prefix for input ids, e.g. 'blog' -> #blog-search */
  idPrefix: string;
  searchPlaceholder: string;
  tags: string[];
  /** Omit to hide the Year select */
  years?: number[];
  /** Series slugs with their topics; omit or leave empty to hide the Series filter */
  series?: { id: string; topics: string[] }[];
  /** Orders for the Sort by select, the first being the default; omit to hide it.
      `orders` names its ascending and descending orders, e.g. A–Z and Z–A;
      without it, the sort has one order. It starts ascending unless
      `startDescending`, e.g. dates newest first. `icon` is 'date' for a
      calendar on the direction button, letters otherwise */
  sorts?: { value: string; label: string; orders?: { asc: string; desc: string }; startDescending?: boolean; icon?: 'date' | 'text' }[];
}

const { idPrefix, searchPlaceholder, tags, years, series = [], sorts = [] } = Astro.props;

// The direction button's icons from Lucide, by sort icon and direction; the
// filter script shows one. Dates are calendar-arrow-up/-down, the rest
// arrow-down-a-z/-z-a
const sortIcons = {
  'date-asc': '<path d="m14 17 4-4 4 4" /><path d="M16 2v3" /><path d="M18 21v-8" /><path d="M21 10.343V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h9" /><path d="M3 9h18" /><path d="M8 2v3" />',
  'date-desc': '<path d="m14 17 4 4 4-4" /><path d="M16 2v3" /><path d="M18 13v8" /><path d="M21 10.354V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h7.343" /><path d="M3 9h18" /><path d="M8 2v3" />',
  'text-asc': '<path d="m3 16 4 4 4-4" /><path d="M7 20V4" /><path d="M20 8h-5" /><path d="M15 10V6.5a2.5 2.5 0 0 1 5 0V10" /><path d="M15 14h5l-5 6h5" />',
  'text-desc': '<path d="m3 16 4 4 4-4" /><path d="M7 4v16" /><path d="M15 4h5l-5 6h5" /><path d="M15 20v-3.5a2.5 2.5 0 0 1 5 0V20" /><path d="M20 18h-5" />',
};
const firstIcon = `${sorts[0]?.icon ?? 'text'}-${sorts[0]?.startDescending ? 'desc' : 'asc'}`;
---

<aside class="filter-panel reveal" style="--delay: 100ms" data-filter-panel>
  <div class="filter-panel-section filter-panel-search">
    <label class="filter-panel-label" for={`${idPrefix}-search`}>Search</label>
    <input
      type="text"
      id={`${idPrefix}-search`}
      class="filter-search"
      placeholder={searchPlaceholder}
      data-filter-search
    />
  </div>

  <!-- Mobile only: collapses everything but search so the list isn't pushed off screen -->
  <button
    type="button"
    class="filter-toggle"
    aria-expanded="false"
    aria-controls={`${idPrefix}-filters`}
    data-filter-toggle
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z" />
    </svg>
    Filters
    <svg class="filter-toggle-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>

  <div class="filter-panel-collapse" id={`${idPrefix}-filters`} data-filter-collapse>
    <div class="filter-panel-body">
      {sorts.length > 0 && (
        <div class="filter-panel-section">
          <label class="filter-panel-label" for={`${idPrefix}-sort`}>Sort by</label>
          <div class="filter-sort">
            <select id={`${idPrefix}-sort`} class="filter-select" data-filter-sort>
              {sorts.map(({ value, label, orders, startDescending, icon }) => (
                <option value={value} data-asc={orders?.asc} data-desc={orders?.desc} data-start-descending={startDescending && ''} data-icon={icon}>{label}</option>
              ))}
            </select>
            <!-- Reverses the selected sort, its icon showing what's sorted and
                 which way; the filter script names the order in its label and tooltip -->
            <button type="button" class="filter-sort-direction" aria-label="Sort order" disabled={!sorts[0].orders} data-filter-sort-direction>
              {Object.entries(sortIcons).map(([id, body]) => (
                <span data-sort-icon={id} hidden={id !== firstIcon}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={body} />
                </span>
              ))}
            </button>
          </div>
        </div>
      )}

      {series.length > 0 && (
        <div class="filter-panel-section">
          <span class="filter-panel-label">Series</span>
          <div class="filter-tags" data-filter-series>
            {series.map(({ id }) => (
              <button type="button" class="filter-tag" data-series={id} style={seriesColors(id)}>{seriesName(id)}</button>
            ))}
          </div>
        </div>
      )}

      <!-- The selected series' topics; hidden until a series with topics is selected -->
      {series.some(({ topics }) => topics.length > 0) && (
        <div class="filter-panel-section" data-filter-topic-section hidden>
          <span class="filter-panel-label">Topic</span>
          {series.map(({ id, topics }) => topics.length > 0 && (
            <div class="filter-tags" data-filter-topics={id} style={seriesColors(id)} hidden>
              {topics.map((topic) => (
                <button type="button" class="filter-tag" data-topic={topicId(topic)}>{topic}</button>
              ))}
            </div>
          ))}
        </div>
      )}

      {tags.length > 0 && (
        <div class="filter-panel-section">
          <span class="filter-panel-label">Tags</span>
          <div class="filter-tags" data-filter-tags>
            {sortTags(tags).map((tag) => (
              <button type="button" class="filter-tag" data-tag={tag}>{tagLabel(tag)}</button>
            ))}
          </div>
        </div>
      )}

      {years && years.length > 0 && (
        <div class="filter-panel-section">
          <label class="filter-panel-label" for={`${idPrefix}-year`}>Year</label>
          <select id={`${idPrefix}-year`} class="filter-select" data-filter-year>
            <option value="">All years</option>
            {years.map((year) => (
              <option value={String(year)}>{year}</option>
            ))}
          </select>
        </div>
      )}

      <slot name="extra" />

      <button type="button" class="filter-clear" data-filter-clear>Clear filters</button>
      <div class="filter-result-count" data-filter-count></div>
    </div>
  </div>
</aside>
