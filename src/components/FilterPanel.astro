---
import { tagLabel, sortTags } from '../lib/tags';
import { seriesColors, seriesName } from '../lib/series';

interface Props {
  /** Prefix for input ids, e.g. 'blog' -> #blog-search */
  idPrefix: string;
  searchPlaceholder: string;
  tags: string[];
  /** Omit to hide the Year select */
  years?: number[];
  /** Series slugs; omit or leave empty to hide the Series filter */
  series?: string[];
}

const { idPrefix, searchPlaceholder, tags, years, series = [] } = Astro.props;
---

<aside class="filter-panel reveal" style="--delay: 100ms" data-filter-panel>
  <div class="filter-panel-section">
    <label class="filter-panel-label" for={`${idPrefix}-search`}>Search</label>
    <input
      type="text"
      id={`${idPrefix}-search`}
      class="filter-search"
      placeholder={searchPlaceholder}
      data-filter-search
    />
  </div>

  {series.length > 0 && (
    <div class="filter-panel-section">
      <span class="filter-panel-label">Series</span>
      <div class="filter-tags" data-filter-series>
        {series.map((id) => (
          <button type="button" class="filter-tag" data-series={id} style={seriesColors(id)}>{seriesName(id)}</button>
        ))}
      </div>
    </div>
  )}

  {tags.length > 0 && (
    <div class="filter-panel-section">
      <span class="filter-panel-label">Tags</span>
      <div class="filter-tags" data-filter-tags>
        {sortTags(tags).map((tag) => (
          <button type="button" class="filter-tag" data-tag={tag}>{tagLabel(tag)}</button>
        ))}
      </div>
    </div>
  )}

  {years && years.length > 0 && (
    <div class="filter-panel-section">
      <label class="filter-panel-label" for={`${idPrefix}-year`}>Year</label>
      <select id={`${idPrefix}-year`} class="filter-select" data-filter-year>
        <option value="">All years</option>
        {years.map((year) => (
          <option value={String(year)}>{year}</option>
        ))}
      </select>
    </div>
  )}

  <slot name="extra" />

  <button type="button" class="filter-clear" data-filter-clear>Clear filters</button>
  <div class="filter-result-count" data-filter-count></div>
</aside>
