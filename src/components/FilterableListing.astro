---
import FilterPanel from './FilterPanel.astro';
import HeaderRule from './HeaderRule.astro';
import PostListItem from './PostListItem.astro';
import { postSeries, postTitle, topicId } from '../lib/series';

interface Entry {
  id: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    tags: string[];
    /** Notes only: the topic heading it sits under, and extra search terms */
    topic?: string;
    aliases?: string[];
  };
  /** e.g. "5 min read"; shown with the date when set */
  readTime?: string;
}

interface Props {
  heading: string;
  intro: string;
  accent: 'blog' | 'notes';
  /** Base path for item links, e.g. '/blog' */
  basePath: string;
  searchPlaceholder: string;
  emptyMessage: string;
  /** Pre-sorted (newest first), draft-filtered entries */
  entries: Entry[];
  /** Omit to list everything on one page */
  itemsPerPage?: number;
  itemLabel: string;
  dateStyle: 'long' | 'short';
  /** Show descriptions as excerpts and include them in search */
  showDescriptions?: boolean;
  /** Show each entry's tags as pills */
  showTags?: boolean;
  /** Show the Year filter */
  showYears?: boolean;
  /** Group entries under these headings, in this order, and add a Sort by menu */
  topics?: { id: string; name: string }[];
}

const {
  heading,
  intro,
  accent,
  basePath,
  searchPlaceholder,
  emptyMessage,
  entries,
  itemsPerPage,
  itemLabel,
  dateStyle,
  showDescriptions = false,
  showTags = false,
  showYears = true,
  topics,
} = Astro.props;

const allTags = [...new Set(entries.flatMap((e) => e.data.tags || []))].sort();
const allYears = [...new Set(entries.map((e) => e.data.date.getFullYear()))].sort((a, b) => b - a);
// Each series with its topics in reading order, for the Series filter
const entrySeries = entries.flatMap((e) => postSeries(e.id) ?? []).sort((a, b) => a.order - b.order);
const allSeries = [...new Set(entrySeries.map((s) => s.id))].sort().map((id) => ({
  id,
  topics: [...new Set(entrySeries.flatMap((s) => (s.id === id && s.topic ? [s.topic] : [])))],
}));

// Grouped listings start in the menu's default Topic order: each topic's
// entries A–Z under its heading. The filter script handles the other orders
const byTitle = (a: Entry, b: Entry) =>
  postTitle(a).localeCompare(postTitle(b), 'en', { sensitivity: 'base', numeric: true });
const groups = topics
  ? topics
      .map((topic) => ({ topic, entries: entries.filter((e) => e.data.topic === topic.id).sort(byTitle) }))
      .filter((group) => group.entries.length > 0)
  : [{ topic: undefined, entries }];
const ordered = groups.flatMap((group) => group.entries);
// Grouped listings default to their headings, the rest to newest first (the
// order entries come in). Every sort but Topic runs both ways
const dateSort = { value: 'date', label: 'Date', orders: { asc: 'Oldest first', desc: 'Newest first' }, startDescending: true, icon: 'date' as const };
const titleSort = { value: 'title', label: 'Title', orders: { asc: 'A–Z', desc: 'Z–A' } };
const sorts = topics
  ? [{ value: 'group', label: 'Topic' }, titleSort, dateSort]
  : [
      dateSort,
      titleSort,
      ...(allSeries.length > 0 ? [{ value: 'series', label: 'Series', orders: { asc: 'A–Z', desc: 'Z–A' } }] : []),
    ];
---

<div
  class={`listing-layout accent-${accent}`}
  data-filterable-listing
  data-items-per-page={itemsPerPage && String(itemsPerPage)}
  data-item-label={itemLabel}
  data-has-description={showDescriptions ? 'true' : undefined}
>
  <FilterPanel
    idPrefix={accent}
    searchPlaceholder={searchPlaceholder}
    tags={allTags}
    years={showYears ? allYears : undefined}
    series={allSeries}
    sorts={sorts}
  />

  <section class="listing-section listing-container">
    <div class="page-header reveal" style="--delay: 0ms">
      <h1>{heading}</h1>
      <p class="page-intro">{intro}<slot name="intro" /></p>
      <HeaderRule accent />
    </div>

    {entries.length === 0 ? (
      <div class="empty-state reveal" style="--delay: 150ms">
        <span class="empty-dash" aria-hidden="true">&mdash;</span>
        <p>{emptyMessage}</p>
      </div>
    ) : (
      <ul class:list={['post-list', showDescriptions && 'post-list--lg']} data-list>
        {groups.map(({ topic, entries: groupEntries }) => (
          <Fragment>
            {topic && (
              <li
                class="post-list-group reveal"
                style={`--delay: ${15 * ordered.indexOf(groupEntries[0])}ms`}
                data-group-heading={topic.id}
              >
                <h2 class="caps-label">{topic.name}</h2>
              </li>
            )}
            {groupEntries.map((entry) => {
              const series = postSeries(entry.id);
              return (
                <PostListItem
                  href={`${basePath}/${entry.id}/`}
                  title={entry.data.title}
                  date={entry.data.date}
                  dateStyle={dateStyle}
                  readTime={entry.readTime}
                  description={showDescriptions ? entry.data.description : undefined}
                  tags={showTags ? entry.data.tags : undefined}
                  series={series}
                  stretched
                  class="reveal"
                  style={`--delay: ${15 * ordered.indexOf(entry)}ms`}
                  data-tags={(entry.data.tags || []).join(',')}
                  data-series={series?.id}
                  data-series-order={series?.order}
                  data-series-topic={series?.topic && topicId(series.topic)}
                  data-date={entry.data.date.toISOString().slice(0, 10)}
                  data-title={postTitle(entry)}
                  data-sort-title={entry.data.title}
                  data-description={showDescriptions ? entry.data.description || '' : undefined}
                  data-group={entry.data.topic}
                  data-aliases={entry.data.aliases?.join(', ')}
                />
              );
            })}
          </Fragment>
        ))}
      </ul>
    )}

    <nav class="pagination" data-pagination aria-label="Pagination"></nav>
  </section>
</div>

<script>
  import { initFilters } from '../scripts/initFilters';

  function init() {
    const root = document.querySelector<HTMLElement>('[data-filterable-listing]');
    if (!root) return;
    initFilters({
      itemsPerPage: Number(root.dataset.itemsPerPage) || undefined,
      itemLabel: root.dataset.itemLabel || 'posts',
      // Topic headings share the list, so match only the entries
      itemSelector: '.post-list-item',
      hasDescription: root.dataset.hasDescription === 'true',
    });
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  .listing-section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }
</style>
