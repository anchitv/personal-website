---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import HeadingLinks from '../../components/HeadingLinks.astro';
import PostMeta from '../../components/PostMeta.astro';
import SeriesCrumbs from '../../components/SeriesCrumbs.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { tagLabel } from '../../lib/tags';
import { checkSeries, postSeries, postTitle } from '../../lib/series';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  checkSeries(allPosts);
  const posts = allPosts.filter(({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const series = postSeries(post.id);
const title = postTitle(post);
const { Content, headings, remarkPluginFrontmatter } = await render(post);

// [[part:…]] placeholders that aren't an earlier part (see src/remark-part-refs.mjs)
const { partRefErrors } = remarkPluginFrontmatter;
if (partRefErrors) {
  throw new Error(
    `Blog post "${post.id}" has placeholders that aren't earlier parts of its series: ${partRefErrors.join(', ')}. A post only refers back: use [[part:<name>]] with a part listed before it in src/lib/series.ts`
  );
}

// Longest read time a post may show; longer ones get trimmed or split into a series
const MAX_READ_MINUTES = 5;
if (parseInt(remarkPluginFrontmatter.minutesRead) > MAX_READ_MINUTES) {
  throw new Error(
    `Blog post "${post.id}" is a ${remarkPluginFrontmatter.minutesRead}. Posts can be at most ${MAX_READ_MINUTES} min (${MAX_READ_MINUTES * 200} words): trim it or split it into a series.`
  );
}
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const ogImage = `/og/blog/${post.id}.png`;
const canonical = new URL(`/blog/${post.id}/`, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url: canonical,
  mainEntityOfPage: canonical,
  image: new URL(ogImage, Astro.site).href,
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.map(tagLabel).join(', ') }),
  author: {
    '@type': 'Person',
    '@id': 'https://anchitverma.com/#person',
    name: 'Anchit Verma',
    url: 'https://anchitverma.com/',
  },
};
---

<BaseLayout
  title={`${title} | Anchit Verma`}
  description={post.data.description}
  ogImage={ogImage}
  ogImageAlt={`"${title}" — blog post by Anchit Verma`}
  ogType="article"
  structuredData={structuredData}
>
  <div class:list={['post-layout', toc.length > 1 && 'post-layout--toc']}>
    {toc.length > 1 && (
      <aside class="toc-sidebar accent-blog">
        <TableOfContents headings={toc} />
      </aside>
    )}
    <article class="prose accent-blog">
      <header class="entry-header">
        {series && <SeriesCrumbs series={series} breadcrumb />}
        <h1>{post.data.title}</h1>
        <PostMeta
          date={post.data.date}
          readTime={remarkPluginFrontmatter.minutesRead}
          tags={post.data.tags}
        />
      </header>
      <!-- Its own block, so the contents can start level with the header's rule rather than the title -->
      <div class="post-body">
        <Content />
        <HeadingLinks />
        <CodeCopy />
        {series && <SeriesNav id={series.id} posts={posts} current={post.id} />}
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  /* Series above the title; it takes the title's top margin. :global because
     it's SeriesCrumbs' element */
  .entry-header :global(.series-crumbs) {
    margin-top: var(--space-xl);
    margin-bottom: 0;
  }

  .entry-header :global(.series-crumbs) + h1 {
    margin-top: 0.15em;
  }

  .toc-sidebar {
    display: none;
  }

  /* Wide screens: contents in the left margin, post stays centred */
  @media (min-width: 1280px) {
    .post-layout--toc {
      display: grid;
      grid-template-columns: 1fr minmax(0, var(--prose-width)) 1fr;
    }

    /* The article spans two rows, its header and its body, as on notes, so
       the contents can start on the second */
    .post-layout--toc .prose {
      grid-column: 2;
      grid-row: 1 / span 2;
      display: grid;
      grid-template-rows: subgrid;
      width: 100%;
    }

    .post-layout--toc .post-body {
      min-width: 0;
    }

    .toc-sidebar {
      display: block;
      grid-column: 1;
      grid-row: 2;
      justify-self: end;
      align-self: start;
      position: sticky;
      /* As on notes, it never scrolls on its own: it stays in view under the
         header, and contents taller than the window scroll with the page
         until the last heading shows, then stay there. --side-height comes
         from the script below */
      top: min(
        calc(var(--header-height) + var(--space-md)),
        calc(100vh - var(--side-height, 0px) - var(--space-md))
      );
      width: min(15rem, 100%);
      /* Pulled up so the Contents label's rule continues the rule under the
         post's title: back over the header's gap and its rule, then the
         label's own height */
      margin-top: calc(-1 * (var(--space-xl) + 1px + var(--text-list-heading) * var(--leading-heading) + var(--space-xs)));
      padding-left: var(--space-md);
    }
  }
</style>

<script>
  // The contents' height, for where they stick on wide screens. It changes
  // when the fonts load and when the window's width changes the text size
  function measureContents() {
    const side = document.querySelector<HTMLElement>('.toc-sidebar');
    if (!side) return;
    new ResizeObserver(() => {
      side.style.setProperty('--side-height', `${side.offsetHeight}px`);
    }).observe(side);
  }

  document.addEventListener('astro:page-load', measureContents);
</script>
