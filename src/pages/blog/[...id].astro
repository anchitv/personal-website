---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { tagLabel } from '../../lib/tags';
import { checkSeries, postSeries, postTitle, seriesColors, seriesName } from '../../lib/series';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  checkSeries(allPosts);
  const posts = allPosts.filter(({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const series = postSeries(post.id);
const title = postTitle(post);
const { Content, remarkPluginFrontmatter } = await render(post);

// [[part:…]] placeholders that aren't an earlier part (see src/remark-part-refs.mjs)
const { partRefErrors } = remarkPluginFrontmatter;
if (partRefErrors) {
  throw new Error(
    `Blog post "${post.id}" has placeholders that aren't earlier parts of its series: ${partRefErrors.join(', ')}. A post only refers back: use [[part:<file name>]] with a part listed before it in src/lib/series.ts`
  );
}

const ogImage = `/og/blog/${post.id}.png`;
const canonical = new URL(`/blog/${post.id}/`, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url: canonical,
  mainEntityOfPage: canonical,
  image: new URL(ogImage, Astro.site).href,
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.map(tagLabel).join(', ') }),
  author: {
    '@type': 'Person',
    '@id': 'https://anchitverma.com/#person',
    name: 'Anchit Verma',
    url: 'https://anchitverma.com/',
  },
};
---

<BaseLayout
  title={`${title} | Anchit Verma`}
  description={post.data.description}
  ogImage={ogImage}
  ogImageAlt={`"${title}" — blog post by Anchit Verma`}
  ogType="article"
  structuredData={structuredData}
>
  <article class="prose accent-blog">
    <header class="entry-header">
      {series && (
        <a href={`/blog/?series=${series.id}`} class="series-label caps-label" style={seriesColors(series.id)}>
          {seriesName(series.id)} &middot; Part {series.number}
        </a>
      )}
      <h1>{post.data.title}</h1>
      <PostMeta
        date={post.data.date}
        readTime={remarkPluginFrontmatter.minutesRead}
        tags={post.data.tags}
      />
    </header>
    <Content />
    {series && <SeriesNav id={series.id} posts={posts} current={post.id} />}
  </article>
</BaseLayout>

<style>
  /* Series name above the title; it takes the title's top margin */
  .series-label {
    display: inline-block;
    margin-top: var(--space-xl);
    text-decoration: none;
  }

  .series-label:hover {
    text-decoration: underline;
  }

  .entry-header .series-label + h1 {
    margin-top: 0.15em;
  }
</style>
