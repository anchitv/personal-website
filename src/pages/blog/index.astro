---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterableListing from '../../components/FilterableListing.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Anchit Verma" description="Long-form thoughts on software, technology, and craft.">
  <FilterableListing
    heading="Blog"
    intro="Long-form thoughts on software, technology, and craft."
    accent="blog"
    basePath="/blog"
    searchPlaceholder="Search posts..."
    emptyMessage="No blogs yet. Check back soon."
    entries={posts}
    itemsPerPage={10}
    itemLabel="posts"
    dateStyle="long"
    showDescriptions
  />
</BaseLayout>
