---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterableListing from '../../components/FilterableListing.astro';
import { SECTION_DESCRIPTIONS } from '../../lib/sections';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Same read time as the post page, from the reading-time remark plugin
const posts = await Promise.all(
  sortedPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return { ...post, readTime: remarkPluginFrontmatter.minutesRead };
  })
);
---

<BaseLayout title="Blog | Anchit Verma" description={SECTION_DESCRIPTIONS.blog}>
  <FilterableListing
    heading="Blog"
    intro={SECTION_DESCRIPTIONS.blog}
    accent="blog"
    basePath="/blog"
    searchPlaceholder="Search posts..."
    emptyMessage="No blogs yet. Check back soon."
    entries={posts}
    itemsPerPage={10}
    itemLabel="posts"
    dateStyle="long"
    showDescriptions
    showTags
  />
</BaseLayout>
