---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderRule from '../../components/HeaderRule.astro';
import PostListItem from '../../components/PostListItem.astro';
import { tagLabel } from '../../lib/tags';

export async function getStaticPaths() {
  const [blogEntries, noteEntries, projectEntries] = await Promise.all([
    getCollection('blog', ({ data }) => !data.draft),
    getCollection('notes', ({ data }) => !data.draft),
    getCollection('projects', ({ data }) => !data.draft),
  ]);

  const tagMap = new Map<string, {
    posts: typeof blogEntries;
    notes: typeof noteEntries;
    projects: typeof projectEntries;
  }>();

  for (const post of blogEntries) {
    for (const tag of post.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, { posts: [], notes: [], projects: [] });
      tagMap.get(tag)!.posts.push(post);
    }
  }

  for (const note of noteEntries) {
    for (const tag of note.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, { posts: [], notes: [], projects: [] });
      tagMap.get(tag)!.notes.push(note);
    }
  }

  for (const project of projectEntries) {
    for (const tag of project.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, { posts: [], notes: [], projects: [] });
      tagMap.get(tag)!.projects.push(project);
    }
  }

  return Array.from(tagMap.entries()).map(([tag, content]) => ({
    params: { tag },
    props: { tag, ...content },
  }));
}

const { tag, posts, notes, projects } = Astro.props;
const label = tagLabel(tag);

// Sort posts and notes by date (reverse chronological)
const sortedPosts = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const sortedNotes = [...notes].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const sortedProjects = [...projects].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`#${label} | Anchit Verma`} description={`Content tagged with '${label}'`}>
  <section class="tag-page listing-container">
    <div class="page-header reveal" style="--delay: 0ms">
      <h1>#{label}</h1>
      <HeaderRule />
    </div>

    {sortedPosts.length > 0 && (
      <div class="tag-section tag-section--blog" data-reveal>
        <h2>Blog</h2>
        <ul class="post-list">
          {sortedPosts.map((post, i) => (
            <PostListItem
              href={`/blog/${post.id}/`}
              title={post.data.title}
              date={post.data.date}
              dateStyle="short"
              description={post.data.description}
              data-reveal
              style={`--delay: ${15 * i}ms`}
            />
          ))}
        </ul>
      </div>
    )}

    {sortedNotes.length > 0 && (
      <div class="tag-section tag-section--notes" data-reveal>
        <h2>Notes</h2>
        <ul class="post-list">
          {sortedNotes.map((note, i) => (
            <PostListItem
              href={`/notes/${note.id}/`}
              title={note.data.title}
              date={note.data.date}
              dateStyle="short"
              data-reveal
              style={`--delay: ${15 * i}ms`}
            />
          ))}
        </ul>
      </div>
    )}

    {sortedProjects.length > 0 && (
      <div class="tag-section tag-section--projects" data-reveal>
        <h2>Projects</h2>
        <ul class="post-list">
          {sortedProjects.map((project, i) => (
            <PostListItem
              href={`/projects/${project.id}/`}
              title={project.data.title}
              date={project.data.date}
              dateStyle="short"
              description={project.data.description}
              data-reveal
              style={`--delay: ${15 * i}ms`}
            />
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .tag-page {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .page-header h1 {
    color: var(--color-text-heading);
  }

  .page-header :global(.header-rule) {
    margin-top: var(--space-sm);
  }
</style>
