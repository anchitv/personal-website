---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import GitHubIcon from '../../components/GitHubIcon.astro';
import ExternalLinkIcon from '../../components/ExternalLinkIcon.astro';
import AppleIcon from '../../components/AppleIcon.astro';
import GooglePlayIcon from '../../components/GooglePlayIcon.astro';
import { formatDate } from '../../lib/formatDate';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, status, tags, repo, url, appStore, playStore } = project.data;

const statusLabel = status.charAt(0).toUpperCase() + status.slice(1);
const formattedDate = formatDate(date);
---

<BaseLayout
  title={`${title} | Anchit Verma`}
  description={description}
  ogImage={`/og/projects/${project.id}.png`}
  ogImageAlt={`"${title}" — project by Anchit Verma`}
>
  <article class="prose accent-projects">
    <header class="entry-header">
      <h1>{title}</h1>
      <p class="project-description">{description}</p>
      <div class="project-meta">
        <time datetime={date.toISOString()} class="project-date">{formattedDate}</time>
        <span class="meta-separator">&middot;</span>
        <span class={`status-badge status-${status}`}>{statusLabel}</span>
        {tags.length > 0 && (
          <div class="project-tags">
            {tags.map((tag) => (
              <TagPill tag={tag} />
            ))}
          </div>
        )}
      </div>
      {(repo || url || appStore || playStore) && (
        <div class="project-links">
          {repo && (
            <a href={repo} class="link-pill link-pill--md" target="_blank" rel="noopener noreferrer">
              <GitHubIcon />
              Source
            </a>
          )}
          {url && (
            <a href={url} class="link-pill link-pill--md" target="_blank" rel="noopener noreferrer">
              <ExternalLinkIcon />
              Website
            </a>
          )}
          {appStore && (
            <a href={appStore} class="link-pill link-pill--md" target="_blank" rel="noopener noreferrer">
              <AppleIcon />
              App Store
            </a>
          )}
          {playStore && (
            <a href={playStore} class="link-pill link-pill--md" target="_blank" rel="noopener noreferrer">
              <GooglePlayIcon />
              Google Play
            </a>
          )}
        </div>
      )}
    </header>
    <Content />
  </article>
</BaseLayout>

<style>
  .project-description {
    color: var(--color-text-muted);
    font-size: var(--text-description);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .project-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-bottom: var(--space-sm);
    font-family: var(--font-heading);
    font-size: var(--text-meta);
    color: var(--color-text-muted);
  }

  .project-date {
    color: var(--color-text-muted);
  }

  .meta-separator {
    opacity: 0.4;
  }

  .status-badge {
    font-family: var(--font-heading);
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .status-active {
    background: var(--color-status-active-bg);
    color: var(--color-status-active-text);
  }

  .status-archived {
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
  }

  .status-idea {
    background: var(--color-status-idea-bg);
    color: var(--color-status-idea-text);
  }

  .project-tags {
    display: flex;
    gap: 0.35em;
    flex-wrap: wrap;
  }

  .project-links {
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
    margin-top: var(--space-xs);
  }

  /* :global because the Markdown body isn't scoped to this component */
  .prose :global(h2) {
    font-size: var(--fs-md);
  }
</style>
