---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderRule from '../../components/HeaderRule.astro';

const notes = await getCollection('notes', ({ data }) => !data.draft);

// Sorting and letters skip leading punctuation, so ".gitignore" files under G
const sortKey = (term: string) => term.replace(/^[^\p{L}\p{N}]+/u, '');

// Each term links to the section of its note that first uses it, or to the
// note's top when its title, description or opening does. A term its note
// doesn't use fails the build, so the glossary can't drift from what the notes
// say. Both are found in a reader's text, ignoring case and a plural ending
// (src/rehype-glossary-sections.mjs)
const stray: string[] = [];
const linked = await Promise.all(
  notes.map(async (note) => {
    const { remarkPluginFrontmatter } = await render(note);
    const sections: Record<string, string | null> = remarkPluginFrontmatter.glossarySections ?? {};
    return note.data.aliases.flatMap((term) => {
      if (!Object.hasOwn(sections, term)) {
        stray.push(`"${term}" in ${note.filePath}`);
        return [];
      }
      const section = sections[term];
      return [{ term, note, href: `/notes/${note.id}/${section ? `#${section}` : ''}` }];
    });
  }),
);
if (stray.length) {
  throw new Error(`Glossary terms their notes don't use: ${stray.join(', ')}. Use each one in its note or take it out of the note's aliases`);
}

const terms = linked
  .flat()
  .sort((a, b) => sortKey(a.term).localeCompare(sortKey(b.term), 'en', { sensitivity: 'base', numeric: true }));

const letters = new Map<string, typeof terms>();
for (const entry of terms) {
  const first = sortKey(entry.term).charAt(0).toUpperCase();
  const letter = /\p{L}/u.test(first) ? first : '#';
  letters.set(letter, [...(letters.get(letter) ?? []), entry]);
}
---

<BaseLayout
  title="Glossary | Anchit Verma"
  description="Every term my notes cover, A to Z, with a link to the note that explains it."
>
  <section class="listing-container accent-notes">
    <div class="page-header reveal" style="--delay: 0ms">
      <h1>Glossary</h1>
      <p class="page-intro">Every term my <a href="/notes/">notes</a> cover, A to Z. Each one links to the note that explains it.</p>
      <HeaderRule accent />
    </div>

    {[...letters].map(([letter, entries]) => (
      <div class="tag-section tag-section--notes">
        <h2 id={letter === '#' ? 'symbols' : letter.toLowerCase()}>{letter}</h2>
        <ul class="post-list">
          {entries.map(({ term, note, href }) => (
            <li class="post-list-item post-list-item--stretched">
              <a href={href} class="post-link post-link--stretched">
                <span class="post-title">{term}</span>
                <span class="glossary-note">{note.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  /* The note's title sits where a listing shows the date */
  .glossary-note {
    font-family: var(--font-heading);
    font-size: var(--text-meta);
    color: var(--color-text-muted);
    text-align: right;
  }

  @media (max-width: 480px) {
    .glossary-note {
      text-align: left;
    }
  }
</style>
