---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeadingLinks from '../../components/HeadingLinks.astro';
import PostMeta from '../../components/PostMeta.astro';
import { tagLabel } from '../../lib/tags';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const description = note.data.description ?? `${note.data.title} — a note by Anchit Verma`;

const ogImage = `/og/notes/${note.id}.png`;
const canonical = new URL(`/notes/${note.id}/`, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: note.data.title,
  description,
  datePublished: note.data.date.toISOString(),
  url: canonical,
  mainEntityOfPage: canonical,
  image: new URL(ogImage, Astro.site).href,
  ...(note.data.tags.length > 0 && { keywords: note.data.tags.map(tagLabel).join(', ') }),
  author: {
    '@type': 'Person',
    '@id': 'https://anchitverma.com/#person',
    name: 'Anchit Verma',
    url: 'https://anchitverma.com/',
  },
};
---

<BaseLayout
  title={`${note.data.title} | Anchit Verma`}
  description={description}
  ogImage={ogImage}
  ogImageAlt={`"${note.data.title}" — note by Anchit Verma`}
  ogType="article"
  structuredData={structuredData}
>
  <article class="prose accent-notes">
    <header class="entry-header">
      <h1>{note.data.title}</h1>
      <PostMeta
        date={note.data.date}
        tags={note.data.tags}
      />
    </header>
    <Content />
    <HeadingLinks />
  </article>
</BaseLayout>

<style>
  /* :global because the Markdown body isn't scoped to this component */
  .prose :global(h2) {
    font-size: var(--fs-lg);
  }

  .prose :global(h3) {
    font-size: var(--fs-md);
  }
</style>
