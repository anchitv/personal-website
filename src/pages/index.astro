---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/Divider.astro';
import Avatar from '../components/Avatar.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { formatDate } from '../lib/formatDate';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const latestNotes = allNotes
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const latestProjects = allProjects
  .filter((p) => p.data.status === 'active')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://anchitverma.com/#website',
      url: 'https://anchitverma.com/',
      name: 'Anchit Verma',
      description: 'Personal website of Anchit Verma — writing, notes, and projects.',
      publisher: { '@id': 'https://anchitverma.com/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://anchitverma.com/#person',
      name: 'Anchit Verma',
      url: 'https://anchitverma.com/',
    },
  ],
};
---

<BaseLayout title="Anchit Verma" description="Personal website of Anchit Verma -- writing, notes, and projects." structuredData={structuredData}>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <h1 class="hero-title reveal" style="--delay: 0ms">Writing about software, ideas and the things I'm building.</h1>
        {latestPosts[0] && (
          <a href={`/blog/${latestPosts[0].id}/`} class="hero-latest reveal" style="--delay: 80ms">
            <span class="hero-latest-label">Latest:</span> {latestPosts[0].data.title} &rarr;
          </a>
        )}
        <div class="hero-links reveal" style="--delay: 120ms">
          <a href="/about/" class="hero-about">More about me &rarr;</a>
          <span class="hero-icons">
            <a href="https://github.com/anchitv" aria-label="GitHub">
              <GitHubIcon size={18} />
            </a>
            <a href="/rss.xml" aria-label="RSS feed">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" />
              </svg>
            </a>
            <ObfuscatedEmail ariaLabel="Email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </ObfuscatedEmail>
          </span>
        </div>
      </div>
      <!-- Ink portrait -->
      <div class="hero-avatar reveal" style="--delay: 160ms" aria-hidden="true">
        <Avatar class="hero-portrait" size={180} />
      </div>
    </div>
    <!-- Decorative diamond divider -->
    <Divider class="hero-divider" />
  </section>

  <div class="home-content">
    <div class="sections-grid">
      <!-- Writing (Blog) section -->
      <section class="home-section reveal" style="--delay: 100ms">
        <div class="section-top">
          <span class="section-emoji" aria-hidden="true">&#9997;&#65039;</span>
        </div>
        <div class="section-header">
          <h2>Blog</h2>
        </div>
        <p class="section-desc">Long-form thoughts on software, technology, and craft.</p>
        <ul class="preview-list">
          {latestPosts.length === 0 ? (
            <li class="preview-item empty-preview">
              <span class="empty-dash" aria-hidden="true">&mdash;</span>
              <span class="preview-title">First post coming soon</span>
            </li>
          ) : (
            latestPosts.map((post) => (
              <li class="preview-item">
                <a href={`/blog/${post.id}/`} class="preview-link">
                  <span class="preview-title">{post.data.title}</span>
                  <span class="preview-meta">
                    {formatDate(post.data.date)}
                  </span>
                </a>
              </li>
            ))
          )}
        </ul>
        <div class="section-footer">
          <a href="/blog/" class="view-all">View all &rarr;</a>
        </div>
      </section>

      <!-- Notes section -->
      <section class="home-section reveal" style="--delay: 200ms">
        <div class="section-top">
          <span class="section-emoji" aria-hidden="true">&#128221;</span>
        </div>
        <div class="section-header">
          <h2>Notes</h2>
        </div>
        <p class="section-desc">Quick thoughts, things I learned and things worth remembering.</p>
        <ul class="preview-list">
          {latestNotes.length === 0 ? (
            <li class="preview-item empty-preview">
              <span class="empty-dash" aria-hidden="true">&mdash;</span>
              <span class="preview-title">First note coming soon</span>
            </li>
          ) : (
            latestNotes.map((note) => (
              <li class="preview-item">
                <a href={`/notes/${note.id}/`} class="preview-link">
                  <span class="preview-title">{note.data.title}</span>
                  <span class="preview-meta">
                    {formatDate(note.data.date)}
                  </span>
                </a>
              </li>
            ))
          )}
        </ul>
        <div class="section-footer">
          <a href="/notes/" class="view-all">View all &rarr;</a>
        </div>
      </section>

      <!-- Projects section -->
      <section class="home-section reveal" style="--delay: 300ms">
        <div class="section-top">
          <span class="section-emoji" aria-hidden="true">&#128736;&#65039;</span>
        </div>
        <div class="section-header">
          <h2>Projects</h2>
        </div>
        <p class="section-desc">Things I've built or am currently working on.</p>
        <ul class="preview-list">
          {latestProjects.length === 0 ? (
            <li class="preview-item empty-preview">
              <span class="empty-dash" aria-hidden="true">&mdash;</span>
              <span class="preview-title">First project coming soon</span>
            </li>
          ) : (
            latestProjects.map((project) => (
              <li class="preview-item">
                <a href={`/projects/${project.id}/`} class="preview-link">
                  <span class="preview-title">{project.data.title}</span>
                  <span class="preview-meta">{project.data.description}</span>
                </a>
              </li>
            ))
          )}
        </ul>
        <div class="section-footer">
          <a href="/projects/" class="view-all">View all &rarr;</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* === HERO === */
  .hero {
    padding-block: var(--space-lg) var(--space-sm);
    position: relative;
  }

  /* Decorative diamond divider */
  .hero-divider {
    max-width: var(--content-width);
    margin: var(--space-lg) auto 0;
    padding-inline: var(--side-padding);
  }

  .hero-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding-inline: var(--side-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  .hero-title {
    font-family: var(--font-body);
    font-size: clamp(2.25rem, 3vi + 1rem, 3.25rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text-heading);
    margin: 0;
    max-width: 28ch;
    text-wrap: balance;
  }

  /* Latest post pill */
  .hero-latest {
    display: inline-block;
    margin-top: var(--space-sm);
    padding: 0.25em 0.8em;
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    color: var(--color-text-heading);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: color var(--duration-150) ease, border-color var(--duration-150) ease;
  }

  .hero-latest-label {
    color: var(--color-text-muted);
  }

  .hero-latest:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .hero-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hero-about {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-150) ease;
  }

  .hero-icons {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* :global because the email link is created client-side by ObfuscatedEmail;
     its placeholder span is styled too so the icon doesn't shift on swap */
  .hero-icons :global(a),
  .hero-icons :global(.contact-link) {
    display: inline-flex;
    padding: 0.35rem;
    color: var(--color-text-muted);
    transition: color var(--duration-150) ease;
  }

  .hero-about:hover,
  .hero-icons :global(a:hover) {
    color: var(--color-accent);
  }

  /* Portrait */
  .hero-avatar {
    flex-shrink: 0;
    width: clamp(100px, 12vw, 160px);
    height: clamp(100px, 12vw, 160px);
  }

  .hero-portrait {
    transition: transform var(--duration-400) ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-avatar:hover .hero-portrait {
      transform: rotate(-3deg) scale(1.03);
    }
  }

  /* === HOME CONTENT === */
  .home-content {
    max-width: var(--content-width);
    margin: 0 auto;
    padding-inline: var(--side-padding);
    padding-block: var(--space-lg) var(--space-2xl);
  }

  /* === SECTIONS GRID === */
  .sections-grid {
    display: grid;
    gap: var(--space-xl);
  }

  /* === SECTIONS === */
  .home-section {
    --section-accent: var(--color-accent);
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--section-accent);
    border-radius: var(--radius-lg);
    position: relative;
    background: var(--color-bg);
    box-shadow: var(--shadow-panel);
    transition: transform var(--duration-200) ease, box-shadow var(--duration-200) ease, border-color var(--duration-200) ease, background-color var(--duration-200) ease;
  }

  /* Blog — warm amber */
  .home-section:nth-child(1) { --section-accent: var(--color-blog); }
  /* Notes — sage green */
  .home-section:nth-child(2) { --section-accent: var(--color-notes); }
  /* Projects — slate blue */
  .home-section:nth-child(3) { --section-accent: var(--color-projects); }

  .home-section:hover:not(:has(.view-all:hover)) {
    border-color: color-mix(in srgb, var(--section-accent) 25%, var(--color-bg));
    border-top-color: var(--section-accent);
    background-color: color-mix(in srgb, var(--section-accent) 8%, var(--color-bg));
    transform: translateY(-4px);
    box-shadow: var(--shadow-panel-hover);
  }

  :global(html.dark) .home-section:hover:not(:has(.view-all:hover)) {
    background-color: color-mix(in srgb, var(--section-accent) 6%, var(--color-bg));
    border-color: color-mix(in srgb, var(--section-accent) 30%, var(--color-bg));
    border-top-color: var(--section-accent);
    /* Accent halo; lives here because --section-accent is only defined on the card */
    box-shadow:
      var(--shadow-panel-hover),
      0 0 28px -6px color-mix(in srgb, var(--section-accent) 35%, transparent);
  }

  .section-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
  }

  .section-emoji {
    display: block;
    font-size: 1.4rem;
    line-height: 1;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .section-header h2 {
    font-family: var(--font-heading);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--color-text-heading);
    margin: 0;
    transition: color var(--duration-200) ease;
  }

  .home-section:hover:not(:has(.view-all:hover)) .section-header h2 {
    color: var(--section-accent);
  }

  .home-section:hover:not(:has(.view-all:hover)) .view-all {
    color: color-mix(in srgb, var(--section-accent) 80%, var(--color-text));
    border-color: color-mix(in srgb, var(--section-accent) 80%, var(--color-text));
    background-color: var(--color-bg);
  }

  :global(html.dark) .home-section:hover:not(:has(.view-all:hover)) .view-all {
    color: color-mix(in srgb, var(--section-accent) 80%, var(--color-text));
    border-color: color-mix(in srgb, var(--section-accent) 80%, var(--color-text));
    background-color: transparent;
  }

  .home-section:hover:not(:has(.view-all:hover)) .preview-link:hover .preview-title {
    color: var(--section-accent);
  }

  .home-section:hover:not(:has(.view-all:hover)) .preview-item {
    background-image: none;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0;
  }

  .home-section:hover:not(:has(.view-all:hover)) .preview-item:first-child {
    background-image: none;
  }

  .home-section:hover:not(:has(.view-all:hover)) .preview-item:hover {
    background-color: color-mix(in srgb, var(--section-accent) 15%, var(--color-bg));
  }

  :global(html.dark) .home-section:hover:not(:has(.view-all:hover)) .preview-item {
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  :global(html.dark) .home-section:hover:not(:has(.view-all:hover)) .preview-item:hover {
    background-color: color-mix(in srgb, var(--section-accent) 15%, var(--color-bg));
  }

  .home-section:hover:not(:has(.view-all:hover)) .empty-preview {
    border-color: rgba(0, 0, 0, 0.2);
  }

  :global(html.dark) .home-section:hover:not(:has(.view-all:hover)) .empty-preview {
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Pinned to the card bottom so "View all" lines up across a row */
  .section-footer {
    margin-top: auto;
    padding-top: var(--space-md);
  }

  .view-all {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    letter-spacing: 0.02em;
    padding: 0.2em 0.7em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: color var(--duration-200) ease, background-color var(--duration-200) ease, border-color var(--duration-200) ease;
  }

  .view-all:hover {
    color: var(--color-bg);
    background-color: var(--section-accent);
    border-color: var(--section-accent);
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: var(--fs-base);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
    transition: color var(--duration-200) ease;
  }

  /* === PREVIEW LIST === */
  .preview-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .preview-item {
    margin: 0;
    padding: var(--space-sm) 0;
    border-radius: var(--radius-md);
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--color-border) 15%,
      var(--color-border) 95%,
      transparent
    );
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: bottom;
    transition: background-color var(--duration-200) ease;
  }

  .preview-item:first-child {
    background-image:
      linear-gradient(90deg, transparent, var(--color-border) 15%, var(--color-border) 95%, transparent),
      linear-gradient(90deg, transparent, var(--color-border) 15%, var(--color-border) 95%, transparent);
    background-size: 100% 1px, 100% 1px;
    background-position: top, bottom;
  }

  .preview-item:hover {
    background-color: color-mix(in srgb, var(--section-accent) 10%, var(--color-bg));
  }

  .preview-link {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    text-decoration: none;
    color: inherit;
    padding-left: var(--space-sm);
  }

  .preview-link:hover .preview-title {
    color: var(--section-accent);
  }

  .preview-title {
    font-family: var(--font-heading);
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--color-text-heading);
    transition: color var(--duration-150) ease;
  }

  .preview-meta {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-200) ease;
  }

  /* === EMPTY STATES === */
  .empty-preview {
    padding: var(--space-md);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3em;
  }

  .empty-dash {
    font-size: var(--fs-lg);
    color: var(--color-border);
    line-height: 1;
  }

  .empty-preview .preview-title {
    color: var(--color-text-muted);
    font-weight: 400;
    font-style: italic;
  }

  /* === RESPONSIVE === */

  /* Tablet: 2-column grid */
  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-lg) var(--space-md);
    }

    .sections-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .sections-grid .home-section:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: 3-column grid */
  @media (min-width: 1080px) {
    .hero {
      padding-block: var(--space-xl) var(--space-lg);
    }

    .sections-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .sections-grid .home-section:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  /* Ultrawide: 3-column stays but content uses full width */
  @media (min-width: 2000px) {
    .hero-avatar {
      width: 180px;
      height: 180px;
    }
  }
</style>
