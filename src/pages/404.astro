---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Anchit Verma" description="The page you're looking for doesn't exist.">
  <section class="not-found">
    <div class="not-found-inner">
      <!-- AV monogram as the visual centerpiece -->
      <div class="monogram reveal" style="--delay: 0ms" aria-hidden="true">
        <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" class="monogram-svg">
          <!-- Outer decorative rings with slow rotation -->
          <circle class="ring ring-outer" cx="120" cy="120" r="115" fill="none" stroke="currentColor" stroke-width="0.75" opacity="0.15" />
          <circle class="ring ring-inner" cx="120" cy="120" r="105" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1" />
          <!-- Subtle accent dot markers -->
          <circle cx="120" cy="5" r="2" fill="var(--color-accent)" opacity="0.3" class="ring ring-outer" />
          <circle cx="235" cy="120" r="1.5" fill="var(--color-accent)" opacity="0.2" class="ring ring-inner" />

          <!-- AV initials -->
          <text x="120" y="138" text-anchor="middle" font-family="'DM Sans Variable', system-ui, sans-serif" font-size="88" font-weight="700" fill="currentColor" letter-spacing="-0.03em" opacity="0.85">AV</text>
        </svg>
      </div>

      <h1 class="not-found-heading reveal" style="--delay: 100ms">Page not found</h1>
      <p class="not-found-message reveal" style="--delay: 180ms">
        The page you were looking for doesn't exist, or it may have moved.
      </p>

      <nav class="not-found-nav reveal" style="--delay: 260ms" aria-label="Suggested pages">
        <p class="nav-suggestion">Here are some places to start:</p>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/notes">Notes</a></li>
          <li><a href="/projects">Projects</a></li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--space-2xl) var(--side-padding);
    text-align: center;
  }

  .not-found-inner {
    max-width: 36rem;
  }

  /* AV monogram */
  .monogram {
    width: clamp(140px, 25vw, 220px);
    height: clamp(140px, 25vw, 220px);
    margin: 0 auto var(--space-lg);
    color: var(--color-text-heading);
  }

  .monogram-svg {
    width: 100%;
    height: 100%;
  }

  .ring {
    transform-origin: 120px 120px;
  }

  .ring-outer {
    animation: slow-spin 60s linear infinite;
    stroke-dasharray: 8 4;
  }

  .ring-inner {
    animation: slow-spin 45s linear infinite reverse;
    stroke-dasharray: 4 6;
  }

  .not-found-heading {
    font-family: var(--font-heading);
    font-size: var(--fs-2xl);
    font-weight: 700;
    color: var(--color-text-heading);
    margin: 0 0 var(--space-sm);
    letter-spacing: -0.02em;
  }

  .not-found-message {
    font-size: var(--fs-md);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    line-height: var(--leading-body);
  }

  .nav-suggestion {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-heading);
  }

  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .nav-links a {
    font-family: var(--font-heading);
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
    background-color: var(--color-bg-alt);
  }
</style>
