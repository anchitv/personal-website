---
import BaseLayout from "../layouts/BaseLayout.astro";
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro";
import Divider from "../components/Divider.astro";

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://anchit.me/#person',
    name: 'Anchit Verma',
    url: 'https://anchit.me/',
    description: 'Software engineer, tinkerer, and occasional writer.',
  },
};
---

<BaseLayout
  title="About | Anchit Verma"
  description="About Anchit Verma -- software engineer, tinkerer, and occasional writer."
  structuredData={structuredData}
>
  <section class="about-page prose">
    <div class="about-header reveal" style="--delay: 0ms">
      <div class="about-avatar" aria-hidden="true">
        <svg
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
          class="about-svg"
        >
          <!-- Soft background circle -->
          <circle cx="100" cy="100" r="95" fill="var(--color-bg-alt)"></circle>
          <!-- Neck -->
          <rect
            x="82"
            y="140"
            width="36"
            height="20"
            rx="8"
            fill="var(--avatar-skin)"></rect>
          <!-- Shoulders / shirt -->
          <path
            d="M50 185 Q50 158 80 155 L120 155 Q150 158 150 185 Z"
            fill="var(--color-accent)"
            opacity="0.85"></path>
          <!-- Shirt collar -->
          <path
            d="M85 155 L100 168 L115 155"
            fill="none"
            stroke="var(--color-bg)"
            stroke-width="2"></path>
          <!-- Head -->
          <ellipse cx="100" cy="105" rx="48" ry="52" fill="var(--avatar-skin)"
          ></ellipse>
          <!-- Hair -->
          <path
            d="M52 95 Q52 52 100 50 Q148 52 148 95 Q148 72 130 62 Q115 55 100 55 Q85 55 70 62 Q52 72 52 95 Z"
            fill="var(--avatar-hair)"></path>
          <!-- Hair side L -->
          <path
            d="M52 95 Q50 78 58 68"
            fill="var(--avatar-hair)"
            stroke="var(--avatar-hair)"
            stroke-width="4"></path>
          <!-- Hair side R -->
          <path
            d="M148 95 Q150 78 142 68"
            fill="var(--avatar-hair)"
            stroke="var(--avatar-hair)"
            stroke-width="4"></path>
          <!-- Ears -->
          <ellipse cx="53" cy="108" rx="7" ry="10" fill="var(--avatar-skin)"
          ></ellipse>
          <ellipse cx="147" cy="108" rx="7" ry="10" fill="var(--avatar-skin)"
          ></ellipse>
          <!-- Eyebrows -->
          <path
            d="M72 90 Q80 85 90 88"
            fill="none"
            stroke="var(--avatar-hair)"
            stroke-width="2.5"
            stroke-linecap="round"></path>
          <path
            d="M110 88 Q120 85 128 90"
            fill="none"
            stroke="var(--avatar-hair)"
            stroke-width="2.5"
            stroke-linecap="round"></path>
          <!-- Eyes -->
          <ellipse cx="82" cy="100" rx="5" ry="5.5" fill="var(--avatar-eye)"
          ></ellipse>
          <ellipse cx="118" cy="100" rx="5" ry="5.5" fill="var(--avatar-eye)"
          ></ellipse>
          <!-- Eye shine -->
          <circle cx="84" cy="98" r="1.8" fill="#fff"></circle>
          <circle cx="120" cy="98" r="1.8" fill="#fff"></circle>
          <!-- Glasses frames -->
          <rect
            x="66"
            y="91"
            width="30"
            height="20"
            rx="8"
            fill="none"
            stroke="var(--avatar-glasses)"
            stroke-width="2.5"></rect>
          <rect
            x="104"
            y="91"
            width="30"
            height="20"
            rx="8"
            fill="none"
            stroke="var(--avatar-glasses)"
            stroke-width="2.5"></rect>
          <!-- Glasses bridge -->
          <path
            d="M96 100 Q100 96 104 100"
            fill="none"
            stroke="var(--avatar-glasses)"
            stroke-width="2.5"></path>
          <!-- Glasses arms -->
          <line
            x1="66"
            y1="97"
            x2="55"
            y2="100"
            stroke="var(--avatar-glasses)"
            stroke-width="2"
            stroke-linecap="round"></line>
          <line
            x1="134"
            y1="97"
            x2="145"
            y2="100"
            stroke="var(--avatar-glasses)"
            stroke-width="2"
            stroke-linecap="round"></line>
          <!-- Nose -->
          <path
            d="M98 106 Q100 114 103 112"
            fill="none"
            stroke="var(--avatar-skin-shadow)"
            stroke-width="1.5"
            stroke-linecap="round"></path>
          <!-- Mouth - friendly smile -->
          <path
            d="M88 122 Q100 132 112 122"
            fill="none"
            stroke="var(--avatar-mouth)"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </div>
      <h1>About me</h1>
    </div>

    <div class="bio reveal" style="--delay: 100ms">
      <p>
        I am a software engineer who likes to tinker. I write Clojure for work,
        have a few self-hosted servers humming away at home, and tend to spend
        my free time picking up whatever catches my curiosity.
      </p>
      <p>
        This site is a new experiment for me. I've spent years building things
        but never really writing about them. I'm trying to change that by
        putting my thoughts into words, sharing what I learn, and seeing where
        it goes.
      </p>
      <p>
        The site itself is part of the experiment too. Frontend is not my usual
        world, but AI tools have made it possible for me to build it anyway.
        I've been experimenting a lot with AI lately, and this site is one of
        the things that came out of it.
      </p>
    </div>

    <Divider class="contact-divider" />

    <div class="contact-section reveal" style="--delay: 200ms">
      <h2>Want to reach me?</h2>
      <p>
        The best way to get in touch is by email:
        <ObfuscatedEmail />
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    max-width: var(--prose-width);
    margin-inline: auto;
    padding-inline: var(--side-padding);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .about-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .about-header h1 {
    margin-top: var(--space-sm);
  }

  .about-avatar {
    display: inline-block;
    width: clamp(80px, 10vw, 120px);
    height: clamp(80px, 10vw, 120px);
    margin-inline: auto;
  }

  .about-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.08));
  }

  .contact-divider {
    margin-top: var(--space-xl);
  }

  .contact-section {
    margin-top: var(--space-lg);
  }
</style>
